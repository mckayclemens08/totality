# Copy to .env on the server. The real file never enters the repo.
SUPABASE_URL=https://your-project.supabase.co
# The public key the app ships with. Never the service role key.
SUPABASE_ANON_KEY=
# openssl rand -hex 32. The gateway and SearXNG share it to sign thumbnails.
SEARXNG_SECRET=
# openssl rand -hex 32. The Worker presents it to hand over mail, and it's set there as a Worker secret.
MAIL_ARRIVAL_SECRET=
# Outside sending stays off while either is empty. The URL is the totality-send Worker's workers.dev
# address. The secret is openssl rand -hex 32, set there too as a Worker secret.
MAIL_SEND_URL=
MAIL_SEND_SECRET=
