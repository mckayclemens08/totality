// Where the app finds Totality's server. Both values are public by design: the URL is Supabase's address,
// and the key is its publishable key, which ships inside every copy of the app. Row-level security on the
// server is what protects data, not this key. Never put the secret (service_role / sb_secret_) key here.
// To point a build at another backend, override these in App/Local.xcconfig, which git ignores.
TOTALITY_BACKEND_URL = https:/$()/tpekjvhvaehqhkjkqrjc.supabase.co
TOTALITY_BACKEND_KEY = sb_publishable_uyIS1C9s4RL8_Cub-rdnHQ_l8fSG7LR
// Where sealed photos and Reader files are kept (proposal §11-H, issue 54). Point it at the home server
// once it exists, after its folder of blobs has been copied there.
TOTALITY_SEALED_STORE_URL = https:/$()/usetotality.com/blobs/
// Sign in with Google, for Gmail (issue 43). It's an iOS OAuth client ID, which Google treats as public:
// an installed app can't keep a secret, so it has none, and PKCE protects each sign-in instead. Empty
// means Gmail can't be added in this build.
TOTALITY_GOOGLE_CLIENT_ID = 973899545310-9lefpoa9mm5sdel8kpf6mte6n6r6rg1f.apps.googleusercontent.com
